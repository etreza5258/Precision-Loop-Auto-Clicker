
<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#101820"
    android:padding="16dp"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PRECISION LOOP"
            android:textColor="#03DAC5"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AUTO CLICKER"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="16dp"/>

        <!-- نمایش ساعت‌ها -->

        <TextView
            android:id="@+id/phoneClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ساعت گوشی: --:--:--.---"
            android:textColor="#03DAC5"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#1B303A"
            android:padding="14dp"/>

        <TextView
            android:id="@+id/internetClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ساعت اینترنتی ایران: در انتظار همگام‌سازی"
            android:textColor="#FFCA28"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#1B303A"
            android:padding="14dp"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/clockDifference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اختلاف ساعت گوشی با اینترنت: -- ms"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="10dp"/>

        <TextView
            android:id="@+id/syncStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="وضعیت همگام‌سازی: هنوز انجام نشده"
            android:textColor="#80CBC4"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingBottom="10dp"/>

        <!-- انتخاب ساعت مبنا -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مبنای محاسبه زمان شروع"
            android:textColor="#FF9800"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"/>

        <RadioGroup
            android:id="@+id/clockSourceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1B303A"
            android:padding="10dp">

            <RadioButton
                android:id="@+id/radioPhoneClock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="استفاده از ساعت گوشی"
                android:textColor="#FFFFFF"
                android:buttonTint="#03DAC5"
                android:checked="true"
                android:padding="5dp"/>

            <RadioButton
                android:id="@+id/radioInternetClock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="استفاده از ساعت اینترنتی ایران"
                android:textColor="#FFFFFF"
                android:buttonTint="#03DAC5"
                android:padding="5dp"/>

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اختلاف همیشه به صورت ساعت گوشی منهای ساعت اینترنتی نمایش داده می‌شود."
            android:textColor="#80CBC4"
            android:textSize="12sp"
            android:paddingTop="6dp"/>

        <!-- زمان شروع -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="۱. زمان شروع اجرا"
            android:textColor="#FF9800"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="22dp"
            android:paddingBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="4">

            <EditText
                android:id="@+id/startHourInput"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:hint="ساعت"
                android:inputType="number"
                android:maxLength="2"
                android:singleLine="true"
                android:gravity="center"
                android:backgroundTint="#03DAC5"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"/>

            <EditText
                android:id="@+id/startMinuteInput"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:hint="دقیقه"
                android:inputType="number"
                android:maxLength="2"
                android:singleLine="true"
                android:gravity="center"
                android:backgroundTint="#03DAC5"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"/>

            <EditText
                android:id="@+id/startSecondInput"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:hint="ثانیه"
                android:inputType="number"
                android:maxLength="2"
                android:singleLine="true"
                android:gravity="center"
                android:backgroundTint="#03DAC5"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"/>

            <EditText
                android:id="@+id/startMillisInput"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:hint="میلی‌ثانیه"
                android:inputType="number"
                android:maxLength="3"
                android:singleLine="true"
                android:gravity="center"
                android:backgroundTint="#03DAC5"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="زمان شروع بر اساس ساعتی محاسبه می‌شود که در بالا انتخاب کرده‌ای."
            android:textColor="#80CBC4"
            android:textSize="12sp"
            android:paddingTop="6dp"/>

        <!-- سرعت کلیک -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="۲. تنظیمات سرعت کلیک"
            android:textColor="#FF9800"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="22dp"
            android:paddingBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فاصله بین کلیک‌ها - ثانیه"
            android:textColor="#FFFFFF"
            android:paddingTop="5dp"/>

        <EditText
            android:id="@+id/intervalSecondsInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="0"
            android:inputType="number"
            android:singleLine="true"
            android:backgroundTint="#03DAC5"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فاصله بین کلیک‌ها - میلی‌ثانیه"
            android:textColor="#FFFFFF"
            android:paddingTop="10dp"/>

        <EditText
            android:id="@+id/intervalMillisInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="20"
            android:inputType="number"
            android:singleLine="true"
            android:backgroundTint="#03DAC5"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"/>

        <!-- تنظیمات چرخه -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="۳. تنظیمات چرخه"
            android:textColor="#FF9800"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="22dp"
            android:paddingBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مدت چرخه - ثانیه"
            android:textColor="#FFFFFF"/>

        <EditText
            android:id="@+id/cycleSecondsInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="60"
            android:inputType="number"
            android:singleLine="true"
            android:backgroundTint="#03DAC5"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مدت چرخه - میلی‌ثانیه"
            android:textColor="#FFFFFF"
            android:paddingTop="10dp"/>

        <EditText
            android:id="@+id/cycleMillisInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="0"
            android:inputType="number"
            android:singleLine="true"
            android:backgroundTint="#03DAC5"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تعداد کلیک در هر چرخه"
            android:textColor="#FFFFFF"
            android:paddingTop="10dp"/>

        <EditText
            android:id="@+id/clickCountInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="2"
            android:inputType="number"
            android:singleLine="true"
            android:backgroundTint="#03DAC5"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مدت نگه‌داشتن هر لمس - میلی‌ثانیه"
            android:textColor="#FFFFFF"
            android:paddingTop="10dp"/>

        <EditText
            android:id="@+id/touchMillisInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="5"
            android:inputType="number"
            android:singleLine="true"
            android:backgroundTint="#03DAC5"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"/>

        <!-- مکث بین چرخه‌ها -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="۴. مکث بین چرخه‌ها"
            android:textColor="#FF9800"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="22dp"
            android:paddingBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مکث - ثانیه"
            android:textColor="#FFFFFF"/>

        <EditText
            android:id="@+id/pauseSecondsInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="0"
            android:inputType="number"
            android:singleLine="true"
            android:backgroundTint="#03DAC5"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مکث - میلی‌ثانیه"
            android:textColor="#FFFFFF"
            android:paddingTop="10dp"/>

        <EditText
            android:id="@+id/pauseMillisInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="0"
            android:inputType="number"
            android:singleLine="true"
            android:backgroundTint="#03DAC5"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"/>

        <!-- شمارش معکوس -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="۵. شمارش معکوس تا شروع"
            android:textColor="#FF9800"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#1B303A"
            android:padding="14dp">

            <TextView
                android:id="@+id/countdownHour"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00"
                android:textColor="#03DAC5"
                android:textSize="25sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textColor="#FFFFFF"
                android:textSize="24sp"/>

            <TextView
                android:id="@+id/countdownMinute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00"
                android:textColor="#03DAC5"
                android:textSize="25sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textColor="#FFFFFF"
                android:textSize="24sp"/>

            <TextView
                android:id="@+id/countdownSecond"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00"
                android:textColor="#03DAC5"
                android:textSize="25sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="."
                android:textColor="#FFFFFF"
                android:textSize="24sp"/>

            <TextView
                android:id="@+id/countdownMillis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:text="000"
                android:textColor="#03DAC5"
                android:textSize="25sp"
                android:textStyle="bold"
                android:gravity="center"/>
        </LinearLayout>

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="آماده"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="12dp"/>

        <!-- کنترل‌ها -->

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="شروع اجرای لوپی"
            android:textStyle="bold"
            android:textSize="16sp"
            android:backgroundTint="#008577"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="توقف کلیک‌ها"
            android:backgroundTint="#B3261E"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/accessibilityButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="فعال‌سازی دسترسی لمس"/>

        <Button
            android:id="@+id/overlayButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="فعال‌سازی پنل شناور"/>

        <Button
            android:id="@+id/showFloatingButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="نمایش نشانگر و پنل شناور"/>

        <!-- گزارش‌ها -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="۶. گزارش چرخه‌های تکمیل‌شده"
            android:textColor="#FF9800"
            android:textSize="19sp"
            android:textStyle="bold"
            android:paddingTop="26dp"
            android:paddingBottom="12dp"/>

        <TextView
            android:id="@+id/reportSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="هنوز هیچ چرخه‌ای تکمیل نشده است."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="#1B303A"
            android:padding="16dp"
            android:lineSpacingExtra="5dp"/>

        <Button
            android:id="@+id/clearReportsButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="پاک کردن گزارش‌ها"
            android:backgroundTint="#455A64"
            android:textColor="#FFFFFF"/>

        <!-- خاموش کردن برنامه -->

        <Button
            android:id="@+id/shutdownButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="20dp"
            android:text="خاموش کردن کامل برنامه"
            android:textStyle="bold"
            android:backgroundTint="#7F0000"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</ScrollView>
